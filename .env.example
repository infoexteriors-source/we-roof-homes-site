NEXT_PUBLIC_SITE_URL=https://www.weroofhomes.com
# Optional additional exact origins for trusted deployments, comma separated; no wildcards.
FORM_ALLOWED_ORIGINS=
# Keep false until content, offer terms, credentials and DNS are verified.
SITE_LAUNCH_READY=false
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_REVALIDATE_SECRET=
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
# Required for automatic calculator PDF delivery. Sender must be verified in Resend.
RESEND_API_KEY=
ESTIMATE_EMAIL_FROM=
# Enable Maps Embed API. Restrict this browser key to your website domains and localhost.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
# Address suggestions: enable Maps JavaScript API and Places API (New).
# Optional separate browser key; falls back to the embed key when blank.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Required for production shared rate limiting (Upstash REST API)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CALLRAIL_SCRIPT_URL=
# Server only: enable Places API (New), billing and a restricted Places API key.
# Place ID must identify the official WeRoof Google Maps listing.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
